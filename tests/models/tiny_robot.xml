<!--
  The smallest robot the engine tests need: a box on a free joint, one driven wheel
  and a plane to stand on. The timestep divides a 1042 us loop into two steps.
-->
<mujoco model="tiny robot">
  <option timestep="0.000521"/>

  <worldbody>
    <geom name="floor" type="plane" size="1 1 0.1"/>

    <body name="robot" pos="0 0 0.02">
      <freejoint/>
      <geom name="chassis" type="box" size="0.03 0.04 0.01" mass="0.1"/>

      <body name="wheel" pos="0.035 0 -0.005" zaxis="1 0 0">
        <joint name="wheel" type="hinge"/>
        <geom name="wheel" type="cylinder" size="0.012 0.004" mass="0.005"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor" joint="wheel" gear="0.001"/>
  </actuator>
</mujoco>
